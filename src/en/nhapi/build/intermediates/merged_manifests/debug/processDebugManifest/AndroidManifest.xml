<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="eu.kanade.tachiyomi.extension.en.nhapi"
    android:versionCode="1"
    android:versionName="1.4.1" >

    <uses-sdk
        android:minSdkVersion="29"
        android:targetSdkVersion="37" />

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:hasCode="true"
        android:icon="@mipmap/ic_launcher"
        android:label="NHentai (API v2)" >
        <meta-data
            android:name="tachiyomi.extension.class"
            android:value=".NHentaiApi" />
        <meta-data
            android:name="tachiyomi.extension.factory"
            android:value="false" />
        <meta-data
            android:name="tachiyomi.extension.nsfw"
            android:value="1" />
        <meta-data
            android:name="tachiyomi.extension.hasReadme"
            android:value="1" />

        <activity
            android:name="eu.kanade.tachiyomi.extension.en.nhapi.NHentaiUrlActivity"
            android:exported="true" >
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="nhentai.net"
                    android:pathPrefix="/g/"
                    android:scheme="https" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="eu.kanade.tachiyomi.extension.en.nhapi.androidx-startup"
            android:exported="false" >
            <meta-data
                android:name="okhttp3.internal.platform.PlatformInitializer"
                android:value="androidx.startup" />
        </provider>
    </application>

</manifest>